{
  "extends": "./tsconfig.base.json",
  "include": [
    "src",
    "scripts",
    "server",
    "studio",
    "tests",
    "packages/*/src"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@video-kit/core": [
        "./packages/core/src/index.ts"
      ],
      "@video-kit/core/*": [
        "./packages/core/src/*"
      ]
    }
  }
}
