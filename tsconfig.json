{
  "extends": "./tsconfig.base.json",
  "include": [
    "scripts",
    "server",
    "studio",
    "tests",
    "packages/*/src"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@video-kit/core": [
        "./packages/core/src/index.ts"
      ],
      "@video-kit/core/*": [
        "./packages/core/src/*"
      ],
      "@video-kit/catalog": [
        "./packages/catalog/src/index.ts"
      ],
      "@video-kit/catalog/*": [
        "./packages/catalog/src/*"
      ],
      "@video-kit/render-kit": [
        "./packages/render-kit/src/exports.ts"
      ],
      "@video-kit/render-kit/entry": [
        "./packages/render-kit/src/index.ts"
      ],
      "@video-kit/render-kit/scenes": [
        "./packages/render-kit/src/scenes/registry.ts"
      ],
      "@video-kit/render-kit/timing": [
        "./packages/render-kit/src/timing/wordTimings.ts"
      ],
      "@video-kit/render-kit/layout": [
        "./packages/render-kit/src/design/formats.tsx"
      ],
      "@video-kit/render-engine": [
        "./packages/render-engine/src/index.ts"
      ],
      "@video-kit/render-engine/pdf": [
        "./packages/render-engine/src/pdf.ts"
      ]
    }
  }
}
