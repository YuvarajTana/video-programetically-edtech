{
  "name": "@aidatadynamics/video-kit",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "description": "Multi-channel, spec-driven Remotion kit for Tech, Learn, and Fun video brands.",
  "scripts": {
    "app": "tsx server/index.ts",
    "app:dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite --config studio/vite.config.ts\"",
    "app:build": "vite build --config studio/vite.config.ts",
    "app:test": "node --import tsx --test tests/*.test.ts",
    "ai:setup": "bash scripts/setup-indic-ai.sh",
    "voice:setup": "bash scripts/setup-local-voice.sh",
    "voices:clean": "tsx scripts/clean-cloned-voices.mjs",
    "studio": "remotion studio packages/render-kit/src/index.ts",
    "render": "tsx scripts/render.mjs",
    "render:all": "tsx scripts/render.mjs --all",
    "validate": "tsx scripts/validate.mjs",
    "package": "tsx scripts/package.mjs",
    "captions": "tsx scripts/captions.mjs",
    "voice": "tsx scripts/voice.mjs",
    "produce": "tsx scripts/produce.mjs",
    "queue": "tsx scripts/queue.mjs",
    "publish": "tsx scripts/publish.mjs",
    "cloud:render": "tsx scripts/cloud-render.mjs",
    "new": "tsx scripts/new-video.mjs",
    "topic:new": "tsx scripts/new-video.mjs --channel tech",
    "roadmap": "tsx scripts/roadmap.mjs",
    "qa": "tsx scripts/qa.mjs",
    "cover:check": "tsx scripts/cover-check.mjs",
    "music": "python3 scripts/make-music.py",
    "media:qa": "tsx scripts/media-qa.mjs",
    "fonts": "tsx scripts/gen-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "datasource": "npm run dev -w @video-kit/datasource",
    "db:migrate": "npm run migrate -w @video-kit/datasource",
    "app:dev:all": "concurrently -k -n data,api,web -c yellow,cyan,magenta \"npm run datasource\" \"tsx watch server/index.ts\" \"vite --config studio/vite.config.ts\""
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.2",
    "@fontsource/noto-sans-bengali": "^5.2.8",
    "@fontsource/noto-sans-devanagari": "^5.2.8",
    "@fontsource/noto-sans-kannada": "^5.2.8",
    "@fontsource/noto-sans-malayalam": "^5.2.8",
    "@fontsource/noto-sans-tamil": "^5.2.8",
    "@fontsource/noto-sans-telugu": "^5.2.8",
    "@remotion/bundler": "4.0.501",
    "@remotion/cli": "4.0.501",
    "@remotion/lambda": "4.0.501",
    "@remotion/player": "4.0.501",
    "@remotion/renderer": "4.0.501",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "openai": "^6.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.501",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.0.0",
    "@fontsource/hanken-grotesk": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/noto-sans-symbols": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.6.0",
    "vite": "^7.1.3"
  }
}
