{
  "name": "@aidatadynamics/video-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "description": "Multi-channel, spec-driven Remotion kit for Tech, Learn, and Fun video brands.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "render:all": "node scripts/render.mjs --all",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs",
    "captions": "node scripts/captions.mjs",
    "voice": "node scripts/voice.mjs",
    "produce": "node scripts/produce.mjs",
    "queue": "node scripts/queue.mjs",
    "publish": "node scripts/publish.mjs",
    "cloud:render": "node scripts/cloud-render.mjs",
    "new": "node scripts/new-video.mjs",
    "qa": "node scripts/qa.mjs",
    "fonts": "node scripts/gen-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.501",
    "@remotion/cli": "4.0.501",
    "@remotion/lambda": "4.0.501",
    "@remotion/renderer": "4.0.501",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.501"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.0.0",
    "@fontsource/hanken-grotesk": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
