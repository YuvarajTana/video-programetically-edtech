# Dependencies
node_modules/
.pnpm-store/

# Environment and secrets
.env
.env.*
!.env.example

# Build, render, and packaging outputs
out/
dist/
build/
coverage/
.nyc_output/
.remotion/
.vite/
.turbo/
*.tsbuildinfo
*.lcov

# Caches
.cache/
.eslintcache
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local studio / pipeline state (SQLite DB, narrations, voice samples, model cache)
.video-kit/

# Python virtual environments and bytecode (Kokoro TTS, local voice, Indic AI workers)
.venv*/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Runtime-generated public assets (UUID-scoped uploads and previews)
public/generated/

# Local TTS intermediates. Keep only the normalized master tracks and
# word timings that production specs reference.
public/audio/**/clips/
public/audio/**/*-raw.wav
public/audio/**/*.pending.wav
public/audio/**/*.pending.json

# Pre-monorepo leftovers. Canonical source lives in packages/.
/src/
/studio/
/scripts/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.orig
