{
  "name": "@video-kit/datasource",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persistence for Video Kit: an async repository port, a SQLite adapter, blob storage, and a service that can run in its own process.",
  "exports": {
    ".": "./src/index.ts",
    "./port": "./src/port.ts",
    "./sqlite": "./src/sqlite/index.ts",
    "./service": "./src/http/service.ts",
    "./client": "./src/http/client.ts",
    "./specs": "./src/sqlite/specs.ts"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "migrate": "tsx src/cli.ts migrate",
    "check-specs": "tsx src/cli.ts check-specs",
    "repair-specs": "tsx src/cli.ts repair-specs"
  },
  "dependencies": {
    "@video-kit/core": "1.0.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "zod": "^4.1.5"
  }
}
