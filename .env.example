# Publishing credentials. Copy to .env locally; never commit real values.
YOUTUBE_ACCESS_TOKEN=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Set this to the currently supported version for your Meta app, for example vNN.N.
META_GRAPH_VERSION=

# Optional Remotion Lambda cloud rendering.
REMOTION_LAMBDA_REGION=
REMOTION_LAMBDA_FUNCTION_NAME=
# Optional: discovered or created automatically when omitted.
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_SITE_NAME=video-kit
REMOTION_LAMBDA_CONCURRENCY=10
REMOTION_LICENSE_KEY=

# Local Video Kit Studio overrides.
VIDEO_KIT_PORT=4311
VIDEO_KIT_WEB_PORT=4310
VIDEO_KIT_DB_PATH=.video-kit/video-kit.db
# Optional explicit Python executable for local Kokoro TTS.
TTS_PYTHON=.venv-tts/bin/python3
# Optional explicit Python executable for IndicTrans2 and IndicF5.
INDIC_AI_PYTHON=.venv-indic/bin/python3
# Optional explicit Python executable for local English My Voice synthesis.
LOCAL_VOICE_PYTHON=.venv-local-voice/bin/python3
# Reserved for the explicit, opt-in ElevenLabs adapter.
ELEVENLABS_API_KEY=
# OpenAI Responses API. API billing is separate from ChatGPT subscriptions.
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=gpt-5.6-sol
