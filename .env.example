# Publishing credentials. Copy to .env locally; never commit real values.
YOUTUBE_ACCESS_TOKEN=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Set this to the currently supported version for your Meta app, for example vNN.N.
META_GRAPH_VERSION=

# Optional Remotion Lambda cloud rendering.
REMOTION_LAMBDA_REGION=
REMOTION_LAMBDA_FUNCTION_NAME=
